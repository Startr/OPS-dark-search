# Egress host: home (Pi / mini-server on the residential network)
# PORT is this host's tunnel slot on openco3 (172.18.0.1:PORT). One port per host.
PORT=1080
# openco3's public address (IP, not the /etc/hosts alias — egress boxes don't have it)
OPENCO3=199.241.136.186
# Paste the pubkey printed by install-egress.sh, then commit.
PUBKEY=""
